generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Standard Auth.js (NextAuth v5) PrismaAdapter schema — required for magic-link
// email sign-in (VerificationToken stores the one-time token) regardless of
// session strategy.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  household     Household?
  createdAt     DateTime  @default(now())
}

// One household per user (v1: Albert syncing his own devices — no
// multi-user-per-household or invite flow yet). JSON columns mirror the
// existing localStorage-era client data shapes exactly, so the client logic
// barely changes — just where it persists.
model Household {
  id            String   @id @default(cuid())
  ownerUserId   String   @unique
  owner         User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  subtitle      String?
  trackerState  Json     @default("{}")
  shopChecks    Json     @default("{}")
  batchDate     String?
  weekOverride  Json     @default("{}")
  leftovers     Json     @default("[]")
  customRecipes Json     @default("[]")
  updatedAt     DateTime @updatedAt
}
