generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Region {
  id       String   @id @default(cuid())
  name     String
  keywords String[]
  lat      Float?
  lng      Float?
  radiusKm Float?
  sources  Source[]
  groups   Group[]
  themes   Theme[]
  signals  Signal[]
  digests  DigestReport[]
  areas    Area[]

  createdAt DateTime @default(now())
}

enum AreaUnitType {
  official_planning_suburb
  local_market
  // Analytical grouping of several local markets — e.g. "Northern Suburbs"
  // containing the Durbanville/Bellville/Brackenfell local markets. Same
  // self-relation (parentAreaId) as suburb -> local_market, one level up.
  district
}

enum AreaBoundaryConfidence {
  official
  analytical
  unverified
}

// A suburb or analytical grouping inside a Region — replaces the old
// hardcoded DURBANVILLE_AREAS array in seed.ts. Official suburbs are peers,
// not children of each other (e.g. Stellenridge/Stellenryk are NOT children
// of Durbanville, per Census Main Place data) — parentAreaId only links an
// official suburb up to its optional analytical local_market grouping (e.g.
// "Durbanville local market"), never suburb-to-suburb. See EYESPY.md's
// geographic model / the "local area research system" spec.
model Area {
  id                 String                 @id @default(cuid())
  region             Region                 @relation(fields: [regionId], references: [id])
  regionId           String
  name               String
  unitType           AreaUnitType
  parentArea         Area?                  @relation("AreaMarket", fields: [parentAreaId], references: [id])
  parentAreaId       String?
  childAreas         Area[]                 @relation("AreaMarket")
  aliases            String[]               @default([])
  boundaryConfidence AreaBoundaryConfidence @default(official)
  signals            Signal[]

  createdAt DateTime @default(now())

  @@index([regionId])
}

enum SourceType {
  rss
  open_data
  search
  places
  reddit
  manual_capture
}

model Source {
  id       String     @id @default(cuid())
  region   Region     @relation(fields: [regionId], references: [id])
  regionId String
  type     SourceType
  name     String
  config   Json
  active   Boolean    @default(true)
  signals  Signal[]

  createdAt DateTime @default(now())
}

// A tracked Facebook group — name/label only, never scraped. Used to tag
// manual-capture uploads during the weekly Wednesday session.
model Group {
  id       String   @id @default(cuid())
  region   Region   @relation(fields: [regionId], references: [id])
  regionId String
  label    String
  signals  Signal[]

  createdAt DateTime @default(now())
}

enum ThemeStatus {
  active
  dormant
}

model Theme {
  id          String      @id @default(cuid())
  region      Region      @relation(fields: [regionId], references: [id])
  regionId    String
  label       String
  description String?
  category    String?
  status      ThemeStatus @default(active)
  firstSeenAt DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())
  signals     Signal[]

  createdAt DateTime @default(now())

  @@index([regionId, status])
}

enum CapturedVia {
  automated
  manual_screenshot
}

// A signal isn't just "which theme" — it's also "is this someone needing the
// thing, or a business selling it." Search-API results in particular skew
// almost entirely supply (SEO landing pages target the exact geo+intent
// phrasing we search for). Only demand signals count toward a theme's
// volume/trend; supply is kept as context. Nullable because existing
// signals predate this field and need a one-time reclassification pass
// (see the cron route's classify-batch logic), same as themeId being
// nullable until first classified.
enum SignalType {
  demand
  supply
  unclear
  // Added 2026-08-03: general news/national/international content (mostly
  // from the broad RSS feeds) getting themed as if it were genuine
  // Durbanville-area local demand. classifySignal() now gates on this
  // before theme attach/create — irrelevant signals get signalType
  // "irrelevant" and themeId stays null, so they never pollute a theme
  // and (since signalType is set, not null) never get re-classified on
  // a later run either.
  irrelevant
}

// Added 2026-08-06: found that municipal service complaints (water outages,
// potholes, sewage — sourced almost entirely via the ArcGIS City of Cape
// Town Service Requests feed) were topping the "Clear gap" bucket. That's
// gapScore.ts working exactly as designed (high demand, structurally zero
// matching "supply" signal) but wrong for EyeSpy's actual purpose — nobody
// commercially supplies municipal infrastructure, so "no supply" here means
// "the City is failing at its job," not "a business opportunity." This is a
// second, independent axis from demand/supply: civic_municipal = only the
// municipality/government can actually address it (roads, water/electricity
// grid, sewage, streetlights, refuse collection contracts, policing);
// commercial = something a local business/tradesperson/provider could
// realistically serve. Nullable for the same reason signalType was —
// existing signals predate this field and need a backfill pass.
enum SignalNature {
  commercial
  civic_municipal
}

model Signal {
  id          String      @id @default(cuid())
  region      Region      @relation(fields: [regionId], references: [id])
  regionId    String
  source      Source      @relation(fields: [sourceId], references: [id])
  sourceId    String
  theme       Theme?      @relation(fields: [themeId], references: [id])
  themeId     String?
  group       Group?      @relation(fields: [groupId], references: [id])
  groupId     String?
  // Which suburb this signal's text names, when determinable (e.g. ArcGIS's
  // own Suburb field, or a name match against search/Reddit/manual-capture
  // text) — nullable, most free-text signals won't resolve to one suburb.
  area        Area?       @relation(fields: [areaId], references: [id])
  areaId      String?
  rawText     String
  url         String?
  capturedVia CapturedVia
  signalType  SignalType?
  nature      SignalNature?
  timestamp   DateTime    @default(now())

  createdAt DateTime @default(now())

  @@index([regionId, themeId])
  @@index([sourceId])
  @@index([areaId])
}

enum DigestGeneratedBy {
  scheduled
  manual
}

// rankedThemes JSON shape per entry: themeId, label, category, bucket
// ("clear_gap"/"rising_crowded"/"watch"), gapScore, supplyRatio,
// trendDirection, demandPeriodCount, demandTotalCount, confidence,
// exampleSignals (string[]), plus for clear_gap: whyGap/verdict/
// verdictReason, for rising_crowded: note. See EYESPY.md's Processing
// steps 5-6 and Output section (both added 2026-08-02) for the full spec.
model DigestReport {
  id              String            @id @default(cuid())
  region          Region            @relation(fields: [regionId], references: [id])
  regionId        String
  period          String
  rankedThemes    Json
  rollupNote      String?
  excludedSummary String?
  generatedBy     DigestGeneratedBy @default(scheduled)
  generatedAt     DateTime          @default(now())

  @@index([regionId, period])
}
